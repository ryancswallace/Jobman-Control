# Safe local-development defaults. Do not put production credentials here.
JOBMAN_CONTROL_DATABASE_URL=postgres://postgres:jobman-control-development@127.0.0.1:5432/jobman_control?sslmode=disable
JOBMAN_CONTROL_AUTH_MODE=development
JOBMAN_CONTROL_DEVELOPMENT_AUTH=true
JOBMAN_CONTROL_DEVELOPMENT_NAMESPACE=research
JOBMAN_CONTROL_AGENT_STALE_AFTER=2m
