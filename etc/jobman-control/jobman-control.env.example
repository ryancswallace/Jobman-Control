# Copy to /etc/jobman-control/jobman-control.env, set private mode, and replace
# every placeholder. Never commit the resulting file.
JOBMAN_CONTROL_DATABASE_URL=postgres://jobman-control:replace-me@postgres.example.invalid/jobman_control?sslmode=verify-full
JOBMAN_CONTROL_AUTH_MODE=oidc
JOBMAN_CONTROL_OIDC_ISSUER=https://identity.example.invalid/
JOBMAN_CONTROL_OIDC_AUDIENCE=jobman-control
JOBMAN_CONTROL_AGENT_TOKEN_KEY=replace-with-unpadded-base64url-secret
JOBMAN_CONTROL_LISTEN=0.0.0.0:8080
# The packaged systemd unit overrides these four paths with private files from
# its credential directory. Keep these values for other service managers.
JOBMAN_CONTROL_TLS_CERT_FILE=/etc/jobman-control/tls/server.crt
JOBMAN_CONTROL_TLS_KEY_FILE=/etc/jobman-control/tls/server.key
JOBMAN_CONTROL_AGENT_CA_CERT_FILE=/etc/jobman-control/tls/agent-ca.crt
JOBMAN_CONTROL_AGENT_CA_KEY_FILE=/etc/jobman-control/tls/agent-ca.key
JOBMAN_CONTROL_MIGRATE_ON_START=false

# Optional Dashboard delegation: use an approved public registry and client CA.
# JOBMAN_CONTROL_DELEGATION_REGISTRY_FILE=/etc/jobman-control/delegation.json
# JOBMAN_CONTROL_DELEGATION_CLIENT_CA_FILE=/etc/jobman-control/tls/dashboard-client-ca.pem
# JOBMAN_CONTROL_DELEGATION_AUDIT_RETENTION=2160h
